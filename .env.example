# GOS3 · agente: Manus · papel: Maintainer / DevOps
# fase: Onboarding → Runtime Federation · data: 2026-08-30 · hora: 01:23:42 UTC
# antes: modelo de ambiente sem identificação GOS3.
# depois: variáveis locais documentadas para Ollama, GitHub, S3 e Vortex.
# base: commit e49ef90 · assinatura: Manus · Maintainer / DevOps · GOS3

# GitHub: normalmente será injetado pelo OAuth do host MCP.
# Para execução fora do host, defina GITHUB_TOKEN no ambiente.
GITHUB_API_URL=https://api.github.com

# S3/GoS3 compatível
AWS_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Servidor local do Qwen via Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:0.5b
OLLAMA_CONTEXT=2048

# Identidade declarativa do runtime Vortex
VORTEX_RUNTIME_ID=local
