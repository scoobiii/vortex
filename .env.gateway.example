# GOS3 · Vortex Gateway environment example
# Copy to a secret-managed environment; never commit real values.
NODE_ENV=production
VORTEX_HOST=127.0.0.1
VORTEX_PORT=8787
VORTEX_RUNTIME_ID=vortex-local-dev
VORTEX_GATEWAY_TOKEN=replace-with-a-long-random-token
# Optional remote connector:
# VORTEX_HTTP_CONNECTOR_ENDPOINT=https://connector.example.com/invoke
# Optional credential lease, referenced by credential_id in a request:
# VORTEX_CREDENTIAL_GITHUB_READ=inject-at-runtime
