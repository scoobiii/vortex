{
  "name": "vortex",
  "version": "0.0.1",
  "private": true,
  "description": "Vortex / GOS3 v2.4 — runtime padrão de invocação verificável para LLMs",
  "gos3": {
    "fase": "Discovery → Technical Refinement",
    "proposer": "Claude",
    "papel": "NxN · Proposer",
    "registro": "docs/proposals/claude/README.md"
  },
  "scripts": {
    "preflight": "bash scripts/gos3_preflight.sh --install",
    "test:grok": "ts-node src/agents/grok/tests/contract.test.ts",
    "grok:ping": "ts-node src/agents/grok/adapter/index.ts --fixture=ping",
    "grok:echo": "ts-node src/agents/grok/adapter/index.ts --fixture=echo",
    "grok:dry": "ts-node src/agents/grok/adapter/index.ts --fixture=dry",
    "test:gos3:vortex": "python3 -m unittest discover -s tests -p 'test_vortex_gos3.py' -v",
    "test:all": "npm run preflight && npm run test:gos3:vortex && python3 tests/contract_test.py && npm run test:grok && npm run grok:ping && npm run grok:echo && npm run grok:dry",
    "test": "npm run test:all",
    "vortex:gos3": "python3 src/vortex_gos3.py . --task 'audit repository'"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "@types/node": "^20.14.10"
  }
}
